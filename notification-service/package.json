{
  "name": "documind-notification-service",
  "version": "1.0.0",
  "description": "DocuMind Notification Microservice — Node.js + Express",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bull": "^4.16.0",
    "express": "^4.19.2",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "joi": "^17.13.1",
    "mongoose": "^8.4.1",
    "nodemailer": "^6.9.13",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
